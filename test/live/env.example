# Copy to .env.live at the root of the repository (git ignores it), fill in,
# and run scripts/live-test.sh. Keys and tokens can also come from the
# environment instead.

# A GitHub repository kept for testing. The run opens and merges pull requests
# in it. Empty GITHUB_TOKEN takes the token of "gh auth token".
FM_LIVE_REPO=your-org/a-test-repository
GITHUB_TOKEN=

# A Linear workspace kept for testing, and two of its teams: tickets are made
# in the first, and one moves to the second. The key needs write access, to
# make the tickets. factorymeter itself only reads.
LINEAR_API_KEY=
FM_LIVE_LINEAR_TEAM=ENG
FM_LIVE_LINEAR_OTHER_TEAM=OPS

# A Jira Cloud site kept for testing, and a software project in it. The
# account makes the tickets. factorymeter itself only reads.
FM_LIVE_JIRA_SITE=your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
FM_LIVE_JIRA_PROJECT=KAN

# Optional: a name for a new set of tickets and pull requests. The default,
# fm-live, is made once and checked again on every run.
# FM_LIVE_RUN=fm-live-2

# Optional: 0 skips the install script and upgrade against the real releases.
# FM_LIVE_RELEASES=0
